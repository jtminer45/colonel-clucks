{"title": "Colonel Clucks Poultry: farm-raised broilers in Jos", "seo_title": "Colonel Clucks Poultry | Farm-raised broilers, Jos", "description": "Colonel Clucks Poultry is a farm-raised agric start-up in Jos, Plateau State. Pre-order whole or cut broilers from Batch 1, ready 18-23 December 2026.", "slug": "home", "content": "<!-- wp:group {\"className\":\"cc-hero\"} -->\n<div class=\"wp-block-group cc-hero\"><!-- wp:image {\"id\":{{IMG_LOGO}}_ID,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"hero-logo\"} -->\n<figure class=\"wp-block-image size-full hero-logo\"><img src=\"{{IMG_LOGO}}_URL\" alt=\"Colonel Clucks Poultry logo: a chicken wearing an army helmet\" class=\"wp-image-{{IMG_LOGO}}_ID\"/></figure>\n<!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"lead-home\"} -->\n<p class=\"lead-home\">Farm-raised poultry, proudly grown in Jos, Plateau State.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"badge\"} -->\n<p class=\"badge\">Batch 1 ready 18 to 23 December 2026</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons {\"className\":\"cc-btns\"} -->\n<div class=\"wp-block-buttons cc-btns\"><!-- wp:button {\"className\":\"btn-gold\"} -->\n<div class=\"wp-block-button btn-gold\"><a class=\"wp-block-button__link wp-element-button\" href=\"#order\">Place your order</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"cc-section\"} -->\n<div class=\"wp-block-group cc-section\"><!-- wp:paragraph {\"className\":\"eyebrow\"} -->\n<p class=\"eyebrow\">How it works</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"anchor\":\"how\"} -->\n<h2 class=\"wp-block-heading\" id=\"how\">Order in three steps</h2>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"steps\"} -->\n<div class=\"wp-block-group steps\"><!-- wp:group {\"className\":\"step\"} -->\n<div class=\"wp-block-group step\"><!-- wp:paragraph {\"className\":\"step-num\"} -->\n<p class=\"step-num\">1</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"step-text\"} -->\n<p class=\"step-text\"><strong>Fill in the form.</strong> Tell us how many birds, whole or cut, and when you want them.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"step\"} -->\n<div class=\"wp-block-group step\"><!-- wp:paragraph {\"className\":\"step-num\"} -->\n<p class=\"step-num\">2</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"step-text\"} -->\n<p class=\"step-text\"><strong>Send it to us.</strong> One tap sends your order to our WhatsApp or by email.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"step\"} -->\n<div class=\"wp-block-group step\"><!-- wp:paragraph {\"className\":\"step-num\"} -->\n<p class=\"step-num\">3</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"step-text\"} -->\n<p class=\"step-text\"><strong>We confirm.</strong> We reply with availability, the price and how you will pay, then arrange pickup or delivery.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"note\"} -->\n<p class=\"note\">No payment is taken on this site. Price and payment are agreed with you directly.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"cc-section\"} -->\n<div class=\"wp-block-group cc-section\"><!-- wp:paragraph {\"className\":\"eyebrow\"} -->\n<p class=\"eyebrow\">What we sell</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"anchor\":\"products\"} -->\n<h2 class=\"wp-block-heading\" id=\"products\">Farm-raised broilers, your way</h2>\n<!-- /wp:heading -->\n<!-- wp:group {\"className\":\"cards\"} -->\n<div class=\"wp-block-group cards\"><!-- wp:group {\"className\":\"card\"} -->\n<div class=\"wp-block-group card\"><!-- wp:paragraph {\"className\":\"tag\"} -->\n<p class=\"tag\">Whole</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Whole broiler</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>A whole bird, collected from the farm or delivered within Jos. Choose your weight when you order.</p>\n<!-- /wp:paragraph -->\n<!-- wp:list {\"className\":\"price-list\"} -->\n<ul class=\"wp-block-list price-list\"><!-- wp:list-item -->\n<li><span>1.5kg</span><span>TBC</span></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><span>2.5kg</span><span>TBC</span></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><span>3.0kg</span><span>TBC</span></li>\n<!-- /wp:list-item --><!-- wp:list-item -->\n<li><span>3.5kg</span><span>TBC</span></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"card\"} -->\n<div class=\"wp-block-group card\"><!-- wp:paragraph {\"className\":\"tag\"} -->\n<p class=\"tag\">Cut</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Cut broiler</h3>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Cleaned and cut, ready to cook, packed in our Colonel Clucks bag.</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"price\"} -->\n<p class=\"price\">Price confirmed when you order</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"weight\"} -->\n<p class=\"weight\">Est. weight: 1.5–1.9 kg</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"note\"} -->\n<p class=\"note\">Batch 1 is small, so pre-orders are first come, first served. Not sure what size to order? Try our <a href=\"/chicken-size-guide/\">chicken size guide and calculator</a>.</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"cc-section\"} -->\n<div class=\"wp-block-group cc-section\"><!-- wp:paragraph {\"className\":\"eyebrow\"} -->\n<p class=\"eyebrow\">Pre-order</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"anchor\":\"order\"} -->\n<h2 class=\"wp-block-heading\" id=\"order\">Place your order</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Fill this in, then choose how to send it to us.</p>\n<!-- /wp:paragraph -->\n<!-- wp:html -->\n<div class=\"cc-app\"><form class=\"formbox\" id=\"orderForm\" novalidate>\n        <div class=\"grid two\">\n          <div class=\"field\" data-field=\"name\">\n            <label for=\"name\">Your name</label>\n            <input id=\"name\" name=\"name\" type=\"text\" autocomplete=\"name\" required>\n            <div class=\"err\">Please enter your name.</div>\n          </div>\n          <div class=\"field\" data-field=\"phone\">\n            <label for=\"phone\">Phone number</label>\n            <input id=\"phone\" name=\"phone\" type=\"tel\" inputmode=\"tel\" autocomplete=\"tel\" placeholder=\"0803 000 0000\" required>\n            <div class=\"err\">Please enter a phone number we can reach you on.</div>\n          </div>\n        </div>\n\n        <div class=\"field\" data-field=\"weight\" style=\"margin-top:16px\">\n          <label id=\"weightLabel\">Choose your weight <small>(applies to whole birds)</small></label>\n          <div class=\"seg seg-4\" role=\"radiogroup\" aria-labelledby=\"weightLabel\">\n            <div><input type=\"radio\" id=\"w15\" name=\"weightTier\" value=\"1.5\" checked><label for=\"w15\">1.5kg<small id=\"pw15\"></small></label></div>\n            <div><input type=\"radio\" id=\"w25\" name=\"weightTier\" value=\"2.5\"><label for=\"w25\">2.5kg<small id=\"pw25\"></small></label></div>\n            <div><input type=\"radio\" id=\"w30\" name=\"weightTier\" value=\"3.0\"><label for=\"w30\">3kg<small id=\"pw30\"></small></label></div>\n            <div><input type=\"radio\" id=\"w35\" name=\"weightTier\" value=\"3.5\"><label for=\"w35\">3.5kg<small id=\"pw35\"></small></label></div>\n          </div>\n        </div>\n\n        <div class=\"field\" data-field=\"birds\" style=\"margin-top:16px\">\n          <label id=\"birdsLabel\">How many birds? <small>(mix whole and cut if you like)</small></label>\n          <div class=\"grid two\" role=\"group\" aria-labelledby=\"birdsLabel\">\n            <div class=\"stepbox\">\n              <span class=\"steplab\">Whole</span>\n              <div class=\"stepper\">\n                <button type=\"button\" class=\"stp\" data-for=\"qtyWhole\" data-d=\"-1\" aria-label=\"One less whole bird\">&minus;</button>\n                <input id=\"qtyWhole\" name=\"qtyWhole\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"500\" step=\"1\" value=\"0\" aria-label=\"Number of whole birds\">\n                <button type=\"button\" class=\"stp\" data-for=\"qtyWhole\" data-d=\"1\" aria-label=\"One more whole bird\">+</button>\n              </div>\n            </div>\n            <div class=\"stepbox\">\n              <span class=\"steplab\">Cut</span>\n              <div class=\"stepper\">\n                <button type=\"button\" class=\"stp\" data-for=\"qtyCut\" data-d=\"-1\" aria-label=\"One less cut bird\">&minus;</button>\n                <input id=\"qtyCut\" name=\"qtyCut\" type=\"number\" inputmode=\"numeric\" min=\"0\" max=\"500\" step=\"1\" value=\"0\" aria-label=\"Number of cut birds\">\n                <button type=\"button\" class=\"stp\" data-for=\"qtyCut\" data-d=\"1\" aria-label=\"One more cut bird\">+</button>\n              </div>\n            </div>\n          </div>\n          <div class=\"err\">Choose at least one bird, whole or cut.</div>\n        </div>\n\n        <div class=\"grid two\" style=\"margin-top:16px\">\n          <div>\n            <label id=\"modeLabel\">Pickup or delivery?</label>\n            <div class=\"seg\" role=\"radiogroup\" aria-labelledby=\"modeLabel\">\n              <div><input type=\"radio\" id=\"mPick\" name=\"mode\" value=\"Pickup\" checked><label for=\"mPick\">Pickup</label></div>\n              <div><input type=\"radio\" id=\"mDel\" name=\"mode\" value=\"Delivery\"><label for=\"mDel\">Delivery</label></div>\n            </div>\n          </div>\n          <div>\n            <label for=\"date\">Date wanted</label>\n            <select id=\"date\" name=\"date\">\n              <option>Any day, 18 to 23 Dec</option>\n              <option>Fri 18 Dec</option>\n              <option>Sat 19 Dec</option>\n              <option>Sun 20 Dec</option>\n              <option>Mon 21 Dec</option>\n              <option>Tue 22 Dec</option>\n              <option>Wed 23 Dec</option>\n            </select>\n          </div>\n        </div>\n\n        <div class=\"field hidden\" id=\"areaBox\" data-field=\"area\" style=\"margin-top:16px\">\n          <label for=\"area\">Delivery area in Jos <small>(street, estate or landmark)</small></label>\n          <input id=\"area\" name=\"area\" type=\"text\" autocomplete=\"street-address\">\n          <div class=\"err\">Please tell us where to deliver in Jos.</div>\n        </div>\n\n        <div style=\"margin-top:16px\">\n          <label for=\"notes\">Anything else? <small>(optional)</small></label>\n          <textarea id=\"notes\" name=\"notes\" placeholder=\"Size preference, event date, questions\"></textarea>\n        </div>\n\n        <div class=\"summary\" aria-live=\"polite\">\n          <h4>Your order summary</h4>\n          <div class=\"ref\">Reference: <span id=\"sumRef\"></span></div>\n          <div class=\"row\"><span>Whole broilers</span><span id=\"sumWhole\"></span></div>\n          <div class=\"row\"><span>Cut broilers</span><span id=\"sumCut\"></span></div>\n          <div class=\"row\"><span>Estimated weight</span><span id=\"sumWeight\"></span></div>\n          <hr>\n          <div class=\"row\"><span id=\"sumModeLabel\">Collection</span><span id=\"sumMode\"></span></div>\n          <div class=\"row hidden\" id=\"sumDeliveryRow\"><span>Delivery fee</span><span id=\"sumDeliveryFee\"></span></div>\n          <hr>\n          <div class=\"row total\"><span>Estimated total</span><span id=\"sumTotal\"></span></div>\n          <p class=\"fine\">Illustrative example only. Final pricing confirmed by the farm.</p>\n        </div>\n\n        <div class=\"preview\" aria-live=\"polite\"><h4>Your order message</h4><span id=\"preview\"></span></div>\n\n        <div class=\"actions\">\n          <a class=\"btn btn-wa\" id=\"sendWa\" href=\"#order\" target=\"_blank\" rel=\"noopener\" style=\"text-align:center\">Send on WhatsApp</a>\n          <a class=\"btn btn-line\" id=\"sendMail\" href=\"#order\" target=\"_blank\" rel=\"noopener\" style=\"text-align:center\">Send by email</a>\n        </div>\n        <p class=\"status\" id=\"status\" role=\"status\"></p>\n        <p class=\"note\" style=\"margin-top:0\">Sending opens your WhatsApp or email app with the order already written. Nothing is sent until you press send there.</p>\n      </form></div>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"cc-section\"} -->\n<div class=\"wp-block-group cc-section\"><!-- wp:paragraph {\"className\":\"eyebrow\"} -->\n<p class=\"eyebrow\">Stay in the loop</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"anchor\":\"newsletter\"} -->\n<h2 class=\"wp-block-heading\" id=\"newsletter\">Join the flock newsletter</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Get a heads-up when new batches open, prices are set and pickup dates are confirmed. No spam, just chicken news.</p>\n<!-- /wp:paragraph -->\n<!-- wp:html -->\n<div class=\"cc-app\"><form class=\"formbox\" id=\"newsForm\" action=\"https://formspree.io/f/xdegawzq\" method=\"POST\">\n        <div class=\"grid two\">\n          <div class=\"field\" data-field=\"newsName\">\n            <label for=\"newsName\">Your name <small>(optional)</small></label>\n            <input id=\"newsName\" name=\"name\" type=\"text\" autocomplete=\"name\">\n          </div>\n          <div class=\"field\" data-field=\"newsEmail\">\n            <label for=\"newsEmail\">Email address</label>\n            <input id=\"newsEmail\" name=\"email\" type=\"email\" autocomplete=\"email\" required>\n            <div class=\"err\">Please enter a valid email address.</div>\n          </div>\n        </div>\n        <input type=\"hidden\" name=\"_subject\" value=\"New Colonel Clucks newsletter signup\">\n        <input type=\"text\" name=\"_gotcha\" style=\"display:none\" tabindex=\"-1\" autocomplete=\"off\">\n        <div class=\"actions\">\n          <button class=\"btn btn-gold\" type=\"submit\" style=\"width:100%\">Sign me up</button>\n        </div>\n        <p class=\"status\" id=\"newsStatus\" role=\"status\"></p>\n      </form></div>\n<!-- /wp:html --></div>\n<!-- /wp:group -->\n\n<!-- wp:group {\"className\":\"cc-section\"} -->\n<div class=\"wp-block-group cc-section\"><!-- wp:paragraph {\"className\":\"eyebrow\"} -->\n<p class=\"eyebrow\">The farm</p>\n<!-- /wp:paragraph -->\n<!-- wp:heading {\"anchor\":\"about\"} -->\n<h2 class=\"wp-block-heading\" id=\"about\">Small start-up, personal service</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>Colonel Clucks Poultry is a farm-raised, farm-to-table agric start-up based in Jos, Plateau State. Batch 1 is small, which means every order gets a personal reply from us, not a form letter. See <a href=\"/about-the-farm/\">how we raise our birds</a> and read our <a href=\"/christmas-chicken-jos/\">Christmas chicken guide</a>.</p>\n<!-- /wp:paragraph -->\n<!-- wp:group {\"className\":\"partner\"} -->\n<div class=\"wp-block-group partner\"><!-- wp:image {\"id\":{{IMG_LONGON}}_ID,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"partner-logo\"} -->\n<figure class=\"wp-block-image size-full partner-logo\"><img src=\"{{IMG_LONGON}}_URL\" alt=\"Longon Farms Nigeria Limited logo\" class=\"wp-image-{{IMG_LONGON}}_ID\"/></figure>\n<!-- /wp:image -->\n<!-- wp:group {\"className\":\"ptext\"} -->\n<div class=\"wp-block-group ptext\"><!-- wp:paragraph {\"className\":\"peyebrow\"} -->\n<p class=\"peyebrow\">Official partner</p>\n<!-- /wp:paragraph -->\n<!-- wp:paragraph -->\n<p>In collaboration with <strong>Longon Farms Nigeria Limited</strong></p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"className\":\"contact about-social\"} -->\n<div class=\"wp-block-group contact about-social\"><!-- wp:paragraph -->\n<p><strong>Location:</strong> Jos, Plateau State</p>\n<!-- /wp:paragraph -->\n<!-- wp:html -->\n<div class=\"social\">\n          <a class=\"icon-btn\" id=\"waIcon\" href=\"https://wa.me/2349135556086\" target=\"_blank\" rel=\"noopener\" aria-label=\"Chat with us on WhatsApp\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21h.004c5.46 0 9.9-4.45 9.9-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.67c2.21 0 4.29.86 5.85 2.42a8.23 8.23 0 0 1 2.43 5.82c0 4.56-3.72 8.26-8.28 8.26a8.3 8.3 0 0 1-4.22-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.4c0-4.56 3.72-8.26 8.27-8.26zm-4.71 4.62c-.17 0-.44.06-.63.3-.19.24-.75.73-.75 1.77 0 1.04.76 2.05.87 2.19.11.15 1.59 2.44 3.88 3.33 1.9.75 2.29.6 2.71.56.42-.04 1.37-.56 1.56-1.1.19-.54.19-1 .13-1.1-.06-.1-.23-.16-.48-.28-.25-.12-1.47-.72-1.7-.8-.23-.08-.4-.12-.56.12-.17.24-.65.82-.8.98-.15.17-.3.19-.56.07-.26-.12-1.07-.4-2.04-1.26-.76-.68-1.26-1.5-1.41-1.75-.15-.25-.02-.38.1-.52.11-.13.26-.33.4-.5.11-.14.17-.25.26-.42.09-.17.04-.32-.03-.44-.07-.12-.6-1.45-.82-1.98-.17-.42-.35-.46-.52-.47h-.42z\"/></svg>\n          </a>\n          <a class=\"icon-btn\" id=\"emailIcon\" href=\"mailto:cluckscolonel@gmail.com\" aria-label=\"Email us\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5v-13zm1.74.26L12 11.2l8.26-5.44H3.74zM20.5 7.1l-8.08 5.33a.75.75 0 0 1-.84 0L3.5 7.1v11.4h17V7.1z\"/></svg>\n          </a>\n          <a class=\"icon-btn\" href=\"https://www.instagram.com/colonelclucks/\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Follow us on Instagram\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.16c3.2 0 3.58.012 4.85.07 1.17.054 1.97.24 2.43.41.59.22 1.01.49 1.46.94.45.45.72.87.94 1.46.17.46.36 1.26.41 2.43.058 1.27.07 1.65.07 4.85s-.012 3.58-.07 4.85c-.054 1.17-.24 1.97-.41 2.43a3.9 3.9 0 0 1-.94 1.46c-.45.45-.87.72-1.46.94-.46.17-1.26.36-2.43.41-1.27.058-1.65.07-4.85.07s-3.58-.012-4.85-.07c-1.17-.054-1.97-.24-2.43-.41a3.9 3.9 0 0 1-1.46-.94 3.9 3.9 0 0 1-.94-1.46c-.17-.46-.36-1.26-.41-2.43C2.172 15.58 2.16 15.2 2.16 12s.012-3.58.07-4.85c.054-1.17.24-1.97.41-2.43.22-.59.49-1.01.94-1.46.45-.45.87-.72 1.46-.94.46-.17 1.26-.36 2.43-.41C8.42 2.172 8.8 2.16 12 2.16zm0 1.62c-3.14 0-3.5.012-4.74.068-1.03.047-1.6.218-1.97.363-.5.194-.85.425-1.22.796-.37.37-.6.72-.8 1.22-.145.37-.316.94-.363 1.97-.056 1.24-.068 1.6-.068 4.74s.012 3.5.068 4.74c.047 1.03.218 1.6.363 1.97.194.5.425.85.796 1.22.37.37.72.6 1.22.8.37.145.94.316 1.97.363 1.24.056 1.6.068 4.74.068s3.5-.012 4.74-.068c1.03-.047 1.6-.218 1.97-.363.5-.194.85-.425 1.22-.796.37-.37.6-.72.8-1.22.145-.37.316-.94.363-1.97.056-1.24.068-1.6.068-4.74s-.012-3.5-.068-4.74c-.047-1.03-.218-1.6-.363-1.97a3.3 3.3 0 0 0-.796-1.22 3.3 3.3 0 0 0-1.22-.8c-.37-.145-.94-.316-1.97-.363-1.24-.056-1.6-.068-4.74-.068zM12 6.87A5.13 5.13 0 1 1 6.87 12 5.13 5.13 0 0 1 12 6.87zm0 1.62A3.51 3.51 0 1 0 15.51 12 3.51 3.51 0 0 0 12 8.49zm5.35-2.9a1.2 1.2 0 1 1-1.2 1.2 1.2 1.2 0 0 1 1.2-1.2z\"/></svg>\n          </a>\n          <a class=\"icon-btn\" href=\"https://www.facebook.com/profile.php?id=61596370718430\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Follow us on Facebook\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z\"/></svg>\n          </a>\n          <a class=\"icon-btn\" href=\"https://x.com/ColonelClucks\" target=\"_blank\" rel=\"noopener noreferrer\" aria-label=\"Follow us on X (Twitter)\">\n            <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z\"/></svg>\n          </a>\n        </div>\n<!-- /wp:html --></div>\n<!-- /wp:group --></div>\n<!-- /wp:group -->\n\n<!-- wp:html -->\n<div class=\"cc-app\"><div class=\"salute\" id=\"salute\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sTitle\" aria-hidden=\"true\">\n  <div class=\"s-card\">\n    <div class=\"s-stage\">\n      <svg viewBox=\"0 0 300 300\" aria-hidden=\"true\" focusable=\"false\">\n        <path d=\"M58 305 C58 238 100 206 150 206 C200 206 242 238 242 305 Z\" fill=\"#FFF6E0\" stroke=\"#232A14\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n        <path d=\"M112 266 q10 -14 20 0 q10 -14 20 0 q10 -14 20 0\" fill=\"none\" stroke=\"#232A14\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n        <path d=\"M126 286 q9 -12 18 0 q9 -12 18 0\" fill=\"none\" stroke=\"#232A14\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n        <g id=\"wing\" fill=\"none\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M222 252 L268 216 L238 132\" stroke=\"#232A14\" stroke-width=\"28\"/>\n          <path d=\"M222 252 L268 216 L238 132\" stroke=\"#FFF6E0\" stroke-width=\"17\"/>\n        </g>\n        <circle cx=\"150\" cy=\"158\" r=\"58\" fill=\"#FFF6E0\" stroke=\"#232A14\" stroke-width=\"6\"/>\n        <path d=\"M94 134 C84 170 108 202 140 209\" fill=\"none\" stroke=\"#4A5D23\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n        <circle cx=\"96\" cy=\"172\" r=\"6\" fill=\"#E8A317\" stroke=\"#232A14\" stroke-width=\"4\"/>\n        <path d=\"M198 198 c14 -4 22 12 14 28 c-8 14 -24 6 -22 -12 z\" fill=\"#E8A317\" stroke=\"#232A14\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n        <path d=\"M205 152 L256 170 L205 190 Z\" fill=\"#E8A317\" stroke=\"#232A14\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n        <path d=\"M208 171 L250 170\" stroke=\"#232A14\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n        <circle cx=\"172\" cy=\"165\" r=\"7\" fill=\"#232A14\"/>\n        <circle cx=\"174\" cy=\"163\" r=\"2.2\" fill=\"#FFF6E0\"/>\n        <path d=\"M156 151 L192 159\" stroke=\"#232A14\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n        <path d=\"M76 124 C76 62 112 40 152 40 C192 40 228 64 228 124 Z\" fill=\"#4A5D23\" stroke=\"#232A14\" stroke-width=\"6\" stroke-linejoin=\"round\"/>\n        <path d=\"M100 96 C106 74 124 60 146 56\" fill=\"none\" stroke=\"#7a8c43\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n        <path d=\"M80 110 C130 102 176 102 224 110\" fill=\"none\" stroke=\"#3a4a1a\" stroke-width=\"6\" stroke-linecap=\"round\"/>\n        <polygon points=\"156,68 160.5,78 171,78.5 163,85 165.5,96 156,90 146.5,96 149,85 141,78.5 151.5,78\" fill=\"#E8A317\" stroke=\"#232A14\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n        <rect x=\"68\" y=\"120\" width=\"170\" height=\"20\" rx=\"10\" fill=\"#3a4a1a\" stroke=\"#232A14\" stroke-width=\"6\"/>\n      </svg>\n    </div>\n    <div class=\"s-body\">\n      <h3 id=\"sTitle\">Roger that!</h3>\n      <p id=\"sMsg\"></p>\n      <p class=\"signoff\" id=\"sSign\"></p>\n      <button type=\"button\" class=\"btn btn-green\" id=\"sClose\">At ease</button>\n    </div>\n  </div>\n</div></div>\n<script>\n/* ===== Edit these when details change ===== */\nvar CONFIG = {\n  whatsapp: \"2349135556086\",   // international format, no + or spaces\n  phoneDisplay: \"0913 555 6086\",\n  email: \"cluckscolonel@gmail.com\", // orders email\n  priceByWeight: {                // naira per whole bird, by weight tier; leave null until prices are set\n    \"1.5\": null,\n    \"2.5\": null,\n    \"3.0\": null,\n    \"3.5\": null\n  },\n  priceCut: null,                 // naira per cut bag\n  weightCut: \"1.5–1.9 kg\",        // estimated weight per cut bird (packed)\n  deliveryFee: null,             // e.g. 1500 (naira, flat fee within Jos); leave null until you set a fee\n  fulfillWindow: \"18 to 23 Dec 2026\" // when orders from this batch are ready\n  // Newsletter signup posts to Formspree (form xdegawzq), see #newsForm action attribute below.\n};\n/* ========================================= */\n\n(function(){\n  var $ = function(id){ return document.getElementById(id); };\n  var form = $('orderForm');\n\n  function priceText(p){ return p ? \"₦\" + Number(p).toLocaleString('en-NG') + \" per bird\" : \"Price confirmed when you order\"; }\n  Object.keys(CONFIG.priceByWeight).forEach(function(kg){\n    var p = CONFIG.priceByWeight[kg];\n    var li = document.createElement('li');\n    li.innerHTML = '<span>' + kg + 'kg</span><span>' + (p ? naira(p) : 'TBC') + '</span>';\n    if($('priceWhole')) $('priceWhole').appendChild(li);\n\n    var tag = $('pw' + kg.replace('.', ''));\n    if(tag) tag.textContent = p ? naira(p) : \"TBC\";\n  });\n  if($('priceCut')) $('priceCut').textContent = priceText(CONFIG.priceCut);\n  if($('weightCut')) $('weightCut').textContent = \"Est. weight: \" + CONFIG.weightCut;\n\n  var tel = CONFIG.whatsapp;\n\n  function val(n){ return (form.elements[n].value || '').trim(); }\n  function radio(n){ var r = form.querySelector('input[name=\"'+n+'\"]:checked'); return r ? r.value : ''; }\n\n  function num(id){ var n = parseInt(form.elements[id].value, 10); return isNaN(n) || n < 0 ? 0 : n; }\n  function naira(n){ return \"₦\" + Number(n).toLocaleString('en-NG'); }\n\n  /* Automatic order reference, kept for this visit so it stays the same across edits */\n  var orderRef = (function(){\n    var key = 'ccOrderRef';\n    try{\n      var existing = sessionStorage.getItem(key);\n      if(existing) return existing;\n    }catch(e){}\n    var ref = 'CC-' + Date.now().toString(36).toUpperCase().slice(-4) + Math.floor(100 + Math.random()*900);\n    try{ sessionStorage.setItem(key, ref); }catch(e){}\n    return ref;\n  })();\n\n  function buildMessage(){\n    var whole = num('qtyWhole'), cut = num('qtyCut'), total = whole + cut;\n    var mode = radio('mode');\n    var tier = radio('weightTier');\n    var parts = [];\n    if(whole) parts.push(whole + \" whole (\" + tier + \"kg)\");\n    if(cut) parts.push(cut + \" cut\");\n    var lines = [\n      \"Hello Colonel Clucks, I would like to order:\",\n      \"\",\n      \"Reference: \" + orderRef,\n      \"Birds: \" + (parts.length ? parts.join(\" + \") + \" (\" + total + \" total)\" : \"__\"),\n      mode === 'Delivery' ? \"Delivery in Jos: \" + (val('area') || '__') : \"Pickup from the farm\",\n      \"Date wanted: \" + form.elements['date'].value,\n      \"Name: \" + (val('name') || '__'),\n      \"Phone: \" + (val('phone') || '__')\n    ];\n    if(val('notes')) lines.push(\"Notes: \" + val('notes'));\n    lines.push(\"\", \"Please confirm availability and price. Thank you.\");\n    return lines.join(\"\\n\");\n  }\n\n  function updateSummary(){\n    var whole = num('qtyWhole'), cut = num('qtyCut');\n    var del = radio('mode') === 'Delivery';\n    var tier = radio('weightTier');\n    var tierPrice = CONFIG.priceByWeight[tier];\n    $('sumRef').textContent = orderRef;\n    $('sumWhole').textContent = whole + (whole === 1 ? \" bird\" : \" birds\") + (whole ? \" (\" + tier + \"kg)\" : \"\");\n    $('sumCut').textContent = cut + (cut === 1 ? \" bird\" : \" birds\");\n\n    if(whole + cut > 0){\n      var wholeKg = whole * Number(tier);\n      var cutLo = parseFloat(CONFIG.weightCut.split('–')[0]), cutHi = parseFloat(CONFIG.weightCut.split('–')[1]);\n      var cutKg = cut * ((cutLo + cutHi) / 2);\n      $('sumWeight').textContent = \"~\" + (wholeKg + cutKg).toFixed(1) + \" kg total\";\n    } else {\n      $('sumWeight').textContent = \"—\";\n    }\n\n    $('sumModeLabel').textContent = del ? \"Delivery\" : \"Collection\";\n    $('sumMode').textContent = del ? (\"Jos\" + (val('area') ? \" – \" + val('area') : \"\")) : \"Farm pickup\";\n    $('sumDeliveryRow').classList.toggle('hidden', !del);\n    $('sumDeliveryFee').textContent = CONFIG.deliveryFee ? naira(CONFIG.deliveryFee) : \"Confirmed by the farm\";\n\n    var haveBirdPrice = whole * (tierPrice||0) + cut * (CONFIG.priceCut||0);\n    var canPrice = (whole===0 || tierPrice) && (cut===0 || CONFIG.priceCut) && (whole+cut>0);\n    if(canPrice){\n      var total = haveBirdPrice + (del ? (CONFIG.deliveryFee||0) : 0);\n      $('sumTotal').textContent = naira(total);\n    } else {\n      $('sumTotal').textContent = \"₦XX,XXX\";\n    }\n  }\n\n  Array.prototype.forEach.call(form.querySelectorAll('.stp'), function(btn){\n    btn.addEventListener('click', function(){\n      var inp = $(btn.getAttribute('data-for'));\n      var v = (parseInt(inp.value,10) || 0) + parseInt(btn.getAttribute('data-d'),10);\n      inp.value = Math.max(0, Math.min(500, v));\n      form.dispatchEvent(new Event('input', {bubbles:true}));\n    });\n  });\n\n  function refresh(){\n    var del = radio('mode') === 'Delivery';\n    $('areaBox').classList.toggle('hidden', !del);\n    $('preview').textContent = buildMessage();\n    updateSummary();\n  }\n  form.addEventListener('input', refresh);\n  form.addEventListener('change', refresh);\n\n  function setInvalid(name, bad){\n    var f = form.querySelector('[data-field=\"'+name+'\"]');\n    if(f) f.classList.toggle('invalid', bad);\n  }\n  function validate(){\n    var ok = true, first = null;\n    var checks = {\n      name: val('name').length > 1,\n      phone: val('phone').replace(/\\D/g,'').length >= 7,\n      birds: num('qtyWhole') + num('qtyCut') >= 1,\n      area: radio('mode') !== 'Delivery' || val('area').length > 2\n    };\n    Object.keys(checks).forEach(function(k){\n      setInvalid(k, !checks[k]);\n      if(!checks[k]){ ok = false; if(!first) first = k; }\n    });\n    if(first){ var el = form.elements[first === 'birds' ? 'qtyWhole' : first]; if(el) el.focus(); }\n    return ok;\n  }\n\n  function updateLinks(){\n    var msg = buildMessage();\n    $('sendWa').href = \"https://wa.me/\" + tel + \"?text=\" + encodeURIComponent(msg);\n    $('sendMail').href = \"mailto:\" + CONFIG.email + \"?subject=\" + encodeURIComponent(\"Order from \" + (val('name') || 'a customer')) + \"&body=\" + encodeURIComponent(msg);\n  }\n  form.addEventListener('input', function(e){\n    var f = e.target.closest ? e.target.closest('.field') : null;\n    if(f) f.classList.remove('invalid');\n    updateLinks();\n  });\n  form.addEventListener('change', updateLinks);\n\n\n  /* ===== Saluting chicken ===== */\n  var salute = $('salute'), lastFocus = null;\n  var TITLES = [\"Roger that, NAME!\", \"Copy that, NAME!\", \"Affirmative, NAME!\"];\n  var SIGNOFFS = [\"Dismissed! Have a cluck-tastic day ahead.\", \"Stay fresh, stay brave, cluck on!\", \"Now go and have a cluck-tastic day, soldier!\"];\n  function pick(a){ return a[Math.floor(Math.random()*a.length)]; }\n  function showSalute(channel){\n    var first = val('name').split(/\\s+/)[0] || 'soldier';\n    $('sTitle').textContent = pick(TITLES).replace('NAME', first);\n    $('sMsg').textContent = \"Your order (ref \" + orderRef + \") is locked and loaded. Press SEND in \" + channel + \" and our command centre will get back to you soon with your price and delivery plan. Batch 1 is ready \" + CONFIG.fulfillWindow + \". Thank you for your service to the flock!\";\n    $('sSign').textContent = pick(SIGNOFFS);\n    lastFocus = document.activeElement;\n    salute.classList.remove('open'); void salute.offsetWidth;\n    salute.classList.add('open');\n    salute.setAttribute('aria-hidden','false');\n    $('sClose').focus();\n  }\n  function hideSalute(){\n    salute.classList.remove('open');\n    salute.setAttribute('aria-hidden','true');\n    if(lastFocus && lastFocus.focus) lastFocus.focus();\n  }\n  $('sClose').addEventListener('click', hideSalute);\n  salute.addEventListener('click', function(e){ if(e.target === salute) hideSalute(); });\n  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && salute.classList.contains('open')) hideSalute(); });\n\n  $('sendWa').addEventListener('click', function(e){\n    if(!validate()){ e.preventDefault(); return; }\n    updateLinks();\n    $('status').textContent = \"Opening WhatsApp. Press send there to place your order.\";\n    showSalute(\"WhatsApp\");\n  });\n  $('sendMail').addEventListener('click', function(e){\n    if(!validate()){ e.preventDefault(); return; }\n    updateLinks();\n    $('status').textContent = \"Opening your email app. Press send there to place your order.\";\n    showSalute(\"your email app\");\n  });\n  refresh();\n  updateLinks();\n\n  /* ===== Newsletter signup ===== */\n  var newsForm = $('newsForm');\n  newsForm.addEventListener('submit', function(e){\n    e.preventDefault();\n    var emailField = newsForm.querySelector('[data-field=\"newsEmail\"]');\n    var email = newsForm.elements['email'].value.trim();\n    var emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n    emailField.classList.toggle('invalid', !emailOk);\n    if(!emailOk){ newsForm.elements['email'].focus(); return; }\n\n    var statusEl = $('newsStatus');\n    var btn = newsForm.querySelector('button[type=\"submit\"]');\n    btn.disabled = true;\n    statusEl.textContent = \"Signing you up...\";\n\n    fetch(newsForm.action, {\n      method: 'POST',\n      body: new FormData(newsForm),\n      headers: { 'Accept': 'application/json' }\n    }).then(function(res){\n      if(res.ok){\n        statusEl.textContent = \"You're on the list! We'll be in touch.\";\n        newsForm.reset();\n      } else {\n        statusEl.textContent = \"Something went wrong. Please try again or email us directly.\";\n      }\n    }).catch(function(){\n      statusEl.textContent = \"Something went wrong. Please try again or email us directly.\";\n    }).finally(function(){\n      btn.disabled = false;\n    });\n  });\n})();\n</script>\n<!-- /wp:html -->\n\n<!-- wp:html -->\n<script type=\"application/ld+json\">{\"@context\": \"https://schema.org\", \"@type\": \"LocalBusiness\", \"name\": \"Colonel Clucks Poultry\", \"url\": \"https://colonelclucks.ng/\", \"image\": \"{{IMG_LOGO}}_URL\", \"description\": \"Farm-raised broiler start-up in Jos, Plateau State. Pre-order whole or cut chicken from Batch 1, ready 18 to 23 December 2026.\", \"email\": \"cluckscolonel@gmail.com\", \"telephone\": \"+2349135556086\", \"address\": {\"@type\": \"PostalAddress\", \"addressLocality\": \"Jos\", \"addressRegion\": \"Plateau State\", \"addressCountry\": \"NG\"}, \"sameAs\": [\"https://www.instagram.com/colonelclucks/\", \"https://www.facebook.com/profile.php?id=61596370718430\", \"https://x.com/ColonelClucks\"]}</script>\n<!-- /wp:html -->"}